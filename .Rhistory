do_current %>%
filter(up_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = sensor))+
geom_point()+
theme_classic()
do_current %>%
filter(up_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = do_sensor))+
geom_point()+
theme_classic()
do_current %>%
filter(low_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = do_sensor))+
geom_point()+
theme_classic()
do_current %>%
filter(bag == c(93:100))%>%
filter(up_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = density))+
geom_point()+
theme_classic()
do_current %>%
filter(bag == c(43:46, 27:30))%>%
filter(low_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = density))+
geom_point()+
theme_classic()
do_mean <- do_current %>%
filter(up_Immersed == "Y") %>%
group_by(datetime, density, tide) %>%
summarize(mean_DO = mean(DO_adj))
do_mean %>%
filter(tide == "L") %>%
ggplot(aes(x = datetime, y = mean_DO, color = density))+
geom_point()+
theme_classic()+
ylim(2,20)
do_mean %>%
filter(tide == "H") %>%
ggplot(aes(x = datetime, y = mean_DO, color = density))+
geom_point()+
theme_classic()+
ylim(2,20)
do_mean_wide <- do_mean %>%
pivot_wider(names_from = density, values_from = mean_DO)
# Calculate differences
do_diff <- do_mean_wide %>%
group_by(tide)%>%
mutate(D_diff = D - C,
S_diff = S - C,
DS_diff = D- S)
do_diff %>%
filter(tide == "H") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=D_diff), color = "yellow")+
geom_point(aes(y =S_diff), color = "green")+
theme_classic()+
geom_hline(yintercept = 0)
do_diff %>%
filter(tide == "L") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=D_diff), color = "yellow")+
geom_point(aes(y =S_diff), color = "green")+
theme_classic()+
geom_hline(yintercept = 0)
do_diff %>%
filter(tide == "L") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=DS_diff), color = "blue")+
theme_classic()+
geom_hline(yintercept = 0)
do_diff %>%
filter(tide == "H") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=DS_diff), color = "blue")+
theme_classic()+
geom_hline(yintercept = 0)
mean(do_diff$D_diff)
sd(do_diff$D_diff)
mean(do_diff$S_diff)
sd(do_diff$S_diff)
mean(do_diff$DS_diff)
sd(do_diff$DS_diff)
do_rack_mean <- do_current %>%
filter(up_Immersed == "Y") %>%
group_by(datetime, rack, density, tide) %>%
summarize(mean_DO = mean(DO_adj))
do_rack_mean %>%
filter(tide == "L") %>%
filter(density == "C") %>%
