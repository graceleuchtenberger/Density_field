"https://towardsdatascience.com/how-to-automatically-import-and-combine-multiple-files-in-r-30a77c0a7732/"
files <- list.files(path = "/Users/graceleuchtenberger/Library/Mobile Documents/com~apple~CloudDocs/Documents/Density_field/data/DO/07092025/do_xlsx_files")
do1 <- data.frame()
for (file in files){
name <- gsub(".xlsx","", file)
do_file <- readxl::read_excel(paste("/Users/graceleuchtenberger/Library/Mobile Documents/com~apple~CloudDocs/Documents/Density_field/data/DO/07092025/do_xlsx_files/",file,sep=""))
do_file$sensor <- name
do1 <- rbind(do1, do_file)
}
colnames(do1) <- c("datetime", "DO", "temp", "DO_adj", "sensor")
files <- list.files(path = "/Users/graceleuchtenberger/Library/Mobile Documents/com~apple~CloudDocs/Documents/Density_field/data/DO/07092025_07222025/do_xlsx_files")
do2 <- data.frame()
for (file in files){
name <- gsub(".xlsx","", file)
do_file <- readxl::read_excel(paste("/Users/graceleuchtenberger/Library/Mobile Documents/com~apple~CloudDocs/Documents/Density_field/data/DO/07092025_07222025/do_xlsx_files/",file,sep=""))
do_file$sensor <- name
do2 <- rbind(do2, do_file)
}
colnames(do2) <- c("datetime", "DO", "temp", "DO_adj", "sensor")
bind_rows(do1, do2)
do <- bind_rows(do1, do2)
View(do)
do$do_sensor <- substr(do$sensor, start = 8, stop = 9)
do$do_sensor <- gsub('_','',do$do_sensor)
do_sensor_key <- read_excel("/Users/graceleuchtenberger/Library/Mobile Documents/com~apple~CloudDocs/Documents/Density_field/data/do_sensor_key.xlsx")
do_sensor_key$do_sensor <- as.character(do_sensor_key$do_sensor)
do <- left_join(do, do_sensor_key, by = "do_sensor")
setwd("/Users/graceleuchtenberger/Library/Mobile Documents/com~apple~CloudDocs/Documents/Density_field/data/Tilt/")
upper_1 <- read_csv("07092025/2403278_Westcott_upper_(0)_Current.csv")
colnames(upper_1) <- c("datetime", "up_speed", "up_head_deg", "up_vel_N", "up_vel_E")
up_temp1 <- read_csv("07092025/2403278_Westcott_upper_(0)_Temperature.csv")
colnames(up_temp1) <- c("datetime", "up_temp")
upper_2 <- read_csv("07232025/2403278_Westcott_upper_(1)_Current.csv")
colnames(upper_2) <- c("datetime", "up_speed", "up_head_deg", "up_vel_N", "up_vel_E")
up_temp2 <- read_csv("07232025/2403278_Westcott_upper_(1)_Temperature.csv")
colnames(up_temp2) <- c("datetime", "up_temp")
lower_1 <- read_csv("07092025/2308203_Westcott_lower_(0)_Current.csv")
colnames(lower_1) <- c("datetime", "low_speed", "low_head_deg", "low_vel_N", "low_vel_E")
low_temp1 <- read_csv("07092025/2308203_Westcott_lower_(0)_Temperature.csv")
colnames(low_temp1) <- c("datetime", "low_temp")
lower_2 <- read_csv("07232025/2308203_Westcott_lower_(1)_Current.csv")
colnames(lower_2) <- c("datetime", "low_speed", "low_head_deg", "low_vel_N", "low_vel_E")
low_temp2 <- read_csv("07232025/2308203_Westcott_lower_(1)_Temperature.csv")
colnames(low_temp2) <- c("datetime", "low_temp")
current1 <- upper_1 %>%
left_join(lower_1, by = "datetime")%>%
left_join(up_temp1, by = "datetime")%>%
left_join(low_temp1, by = "datetime")
current2 <- upper_2 %>%
left_join(lower_2, by = "datetime")%>%
left_join(up_temp2, by = "datetime")%>%
left_join(low_temp2, by = "datetime")
current <- bind_rows(current1, current2)
do_current <- left_join(do, current, by = "datetime")
do_current$up_Immersed <- ifelse(do_current$up_speed < 10, "Y", "N" )
do_current$low_Immersed <- ifelse(do_current$low_speed < 10, "Y", "N" )
do_current %>%
filter(up_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = sensor))+
geom_point()+
theme_classic()
do_current %>%
filter(up_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = do_sensor))+
geom_point()+
theme_classic()
do_current %>%
filter(low_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = do_sensor))+
geom_point()+
theme_classic()
do_current %>%
filter(bag == c(93:100))%>%
filter(up_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = density))+
geom_point()+
theme_classic()
do_current %>%
filter(bag == c(43:46, 27:30))%>%
filter(low_Immersed == "Y") %>%
ggplot(aes(x=datetime, y=DO_adj, colour = density))+
geom_point()+
theme_classic()
do_mean <- do_current %>%
filter(up_Immersed == "Y") %>%
group_by(datetime, density, tide) %>%
summarize(mean_DO = mean(DO_adj))
do_mean %>%
filter(tide == "L") %>%
ggplot(aes(x = datetime, y = mean_DO, color = density))+
geom_point()+
theme_classic()+
ylim(2,20)
do_mean %>%
filter(tide == "H") %>%
ggplot(aes(x = datetime, y = mean_DO, color = density))+
geom_point()+
theme_classic()+
ylim(2,20)
do_mean_wide <- do_mean %>%
pivot_wider(names_from = density, values_from = mean_DO)
# Calculate differences
do_diff <- do_mean_wide %>%
group_by(tide)%>%
mutate(D_diff = D - C,
S_diff = S - C,
DS_diff = D- S)
do_diff %>%
filter(tide == "H") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=D_diff), color = "yellow")+
geom_point(aes(y =S_diff), color = "green")+
theme_classic()+
geom_hline(yintercept = 0)
do_diff %>%
filter(tide == "L") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=D_diff), color = "yellow")+
geom_point(aes(y =S_diff), color = "green")+
theme_classic()+
geom_hline(yintercept = 0)
do_diff %>%
filter(tide == "L") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=DS_diff), color = "blue")+
theme_classic()+
geom_hline(yintercept = 0)
do_diff %>%
filter(tide == "H") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=DS_diff), color = "blue")+
theme_classic()+
geom_hline(yintercept = 0)
mean(do_diff$D_diff)
sd(do_diff$D_diff)
mean(do_diff$S_diff)
sd(do_diff$S_diff)
mean(do_diff$DS_diff)
sd(do_diff$DS_diff)
do_rack_mean <- do_current %>%
filter(up_Immersed == "Y") %>%
group_by(datetime, rack, density, tide) %>%
summarize(mean_DO = mean(DO_adj))
do_rack_mean %>%
filter(tide == "L") %>%
filter(density == "C") %>%
ggplot(aes(x = datetime, y = mean_DO, color = rack))+
geom_point()+
theme_classic()
do_rack_mean %>%
filter(tide == "H") %>%
filter(density == "C") %>%
ggplot(aes(x = datetime, y = mean_DO, color = rack))+
geom_point()+
theme_classic()+
ylim(2,20)
do_rack_mean_wide <- do_rack_mean %>%
pivot_wider(names_from = c(density, rack), values_from = mean_DO)
# Calculate differences
do_rack_diff <- do_rack_mean_wide %>%
group_by(tide)%>%
mutate(C_diff = C_S - C_D,
D_diff = D_S - D_D,
S_diff = S_S - S_D)
do_rack_diff %>%
filter(tide == "H") %>%
ggplot(aes(x = datetime))+
geom_point(aes(y=D_diff), color = "yellow")+
geom_point(aes(y =S_diff), color = "green")+
geom_point(aes(y=C_diff), color = "blue")+
theme_classic()+
geom_hline(yintercept = 0)
mean(do_rack_diff$C_diff)
sd(do_rack_diff$C_diff)
mean(do_rack_diff$D_diff)
sd(do_rack_diff$D_diff)
mean(do_rack_diff$S_diff)
sd(do_rack_diff$S_diff)
