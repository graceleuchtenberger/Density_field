filter(tide == "L") %>%
filter(density == "C") %>%
ggplot(aes(x = datetime, y = mean_DO, color = rack))+
geom_point()+
theme_classic()
do_rack_mean %>%
filter(tide == "H") %>%
filter(density == "C") %>%
ggplot(aes(x = datetime, y = mean_DO, color = rack))+
geom_point()+
theme_classic()+
ylim(2,20)
