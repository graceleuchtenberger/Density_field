sizes <- read_xlsx("data/Growth/Sizes/06272025.xlsx")
treat_key <- read_xlsx("data/treatment_key.xlsx")
colnames(sizes) <- c("date", "bag_num_og", "pic_num", "oyster_num", "length")
sizes$top_bottom <- substring(sizes$bag_num, 4)
sizes$top_bottom <- substring(sizes$bag_num_og, 4)
sizes$bag_num <- substr(sizes$bag_num_og, start = 1, stop = 2)
sizes <- left_join(sizes, treat_key, by = "bag_num")
sizes$bag_num <- as.factor(sizes$bag_num)
treat_key$bag_num <- as.factor(treat_key$bag_num)
sizes <- left_join(sizes, treat_key, by = "bag_num")
library(lmerTest)
library(lme4)
model <- lmer(length ~ density+top_bottom+tide + piling+rack)
model <- lmer(length ~ density+top_bottom+tide + piling+rack + (1|bag_num), data = length)
model <- lmer(length ~ density+top_bottom+tide + piling+rack + (1|bag_num), data = sizes)
summary(model)
mean_sizes <- sizes %>%
group_by(bag_num) %>%
summarise(mean_length = mean(predicted, na.rm = TRUE),
std_error = sd(predicted, na.rm = TRUE)/sqrt(length(mean_length)),
.groups = 'drop')
mean_sizes <- sizes %>%
group_by(bag_num) %>%
summarise(mean_length = mean(length, na.rm = TRUE),
std_error = sd(length, na.rm = TRUE)/sqrt(length(mean_length)),
.groups = 'drop')
View(mean_sizes)
