model1 <-glmmTMB(cbind(alive_num, cumulative_deaths) ~  density+ tide + piling + rack +days + top_bottom+(1|bag_num),  data = survival, family = binomial()) #glmmTMB
summary(model1)
testDispersion(model1)
library(DHARMa)
