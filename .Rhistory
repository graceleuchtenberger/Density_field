figure_a1 <- ggplot(data=mcmc_samples,aes(x=`alpha[1, 2]`-`alpha[2, 2]`)) +
theme(text=element_text(size=20)) +
ggtitle(title) +
labs(x=expression(Slope~(a[1])),y="Density") +
geom_histogram(aes(y=after_stat(density)), fill="gray",bins=30) +
geom_vline(aes(xintercept=(`alpha[1, 2]`-`alpha[2, 2]`)), stat="mean_vline", linetype="dotted") +
geom_rug(stat="sample_mean", sides="b")
figure_a1
