model1 <- glmmTMB(CI ~ tide*top_bottom +(1|bag_num), data = weights2, family = lognormal())
model1 <- glmmTMB(CI ~ tide*top_bottom +(1|Bag), data = weights2, family = lognormal())
summary(model1)
model2 <- glmmTMB(CI ~ tide*top_bottom +(1|Bag), data = weights2, family = gamma(link = "log"))
model2 <- glmmTMB(CI ~ tide*top_bottom +(1|Bag), data = weights2, family = Gamma(link = "logit"))
summary(model2)
testDispersion(model2)
tst_simres <- simulateResiduals(fittedModel = model2) #DHARMa
plot(tst_simres)
testDispersion(model1)
tst_simres <- simulateResiduals(fittedModel = model1) #DHARMa
plot(tst_simres)
testDispersion(model2)
tst_simres <- simulateResiduals(fittedModel = model2) #DHARMa
plot(tst_simres)
model1 <- glmmTMB(CI ~ tide*top_bottom +(1|Bag), data = weights2, family = lognormal())
summary(model1)
testDispersion(model1)
tst_simres <- simulateResiduals(fittedModel = model1) #DHARMa
plot(tst_simres)
car::Anova(model1)
car::Anova(model1, type = "III")
ggplot(weights2, aes(x= tide,y = CI, fill = top_bottom))+
geom_boxplot()+
theme_classic()
