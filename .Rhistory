robo_interp_mean_filtered <- robo_interp_mean %>%
filter(minute(datetime) %in% c(0, 15, 30, 45))
robo_interp_mean %>%
filter(tide == "H")%>%
filter(top_bottom %in% c("2"))%>%
ggplot(aes(x=datetime, y=mean_temp))+
scale_x_datetime(date_labels = "%b %Y", date_breaks = "1 month") +
geom_line(color = "#a6caec")+
labs(x = "Date", y = "Oyster temperature")+
theme_classic()+
theme(axis.text = element_text(color="black",size = 18),      # Change x-axis title size
axis.title = element_text(color="black",size = 20))+
ylim(0,40)
robo_interp_mean_filtered %>%
filter(tide == "H")%>%
filter(top_bottom %in% c("2"))%>%
ggplot(aes(x=datetime, y=mean_temp))+
scale_x_datetime(date_labels = "%b %Y", date_breaks = "1 month") +
geom_line(color = "#a6caec")+
labs(x = "Date", y = "Oyster temperature")+
