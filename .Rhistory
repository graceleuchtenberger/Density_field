files <- list.files(path = "/Users/graceleuchtenberger/Library/Mobile Documents/com~apple~CloudDocs/Documents/Density_field/data/DO/07092025_07222025/con_xlsx_files")
con <- data.frame()
for (file in files){
name <- gsub(".xlsx","", file)
con_file <- readxl::read_excel(paste("/Users/graceleuchtenberger/Library/Mobile Documents/com~apple~CloudDocs/Documents/Density_field/data/DO/07092025_07222025/con_xlsx_files/",file,sep=""))
con_file$sensor <- name
con <- rbind(con, con_file)
}
colnames(con) <- c("datetime", "high_range", "temp", "spec_cond", "sal_ppt", "sensor")
ggplot(con, aes(x=datetime, y=high_range, colour = sensor))+
geom_line()+
theme_classic()
View(con)
ggplot(con, aes(x=datetime, y=sal_ppt, colour = sensor))+
geom_line()+
theme_classic()
con_current <- left_join(con, current, by = "datetime")
con_current$Immersed <- ifelse(con_current$up_speed < 10, "Y", "N" )
con_current %>%
filter(Immersed == "Y") %>%
ggplot(aes(x=datetime, y=sal_ppt, colour = sensor))+
geom_point()+
theme_classic()
con_current %>%
filter(Immersed == "Y") %>%
ggplot(aes(x=datetime, y=mean_con, colour = sensor))+
geom_point()+
theme_classic()
hist(con_current$sal_ppt)
mean(con_current$sal_ppt)
