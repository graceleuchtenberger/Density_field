ggtitle("Bottom/Sparse low tide") +
labs(x="median of CI",y="Density") +
geom_histogram(aes(y=after_stat(density)), fill="gray",bins=30) +
geom_vline(aes(xintercept=(bs_lo)), stat="mean_vline", linetype="dotted") +
geom_rug(stat="sample_mean", sides="b")
figure_top_sparse_hi <- ggplot(data=mcmc_samples_med,aes(x=ts_hi)) +
theme(text=element_text(size=20)) +
ggtitle("Top/Sparse hi tide") +
labs(x="median of CI",y="Density") +
geom_histogram(aes(y=after_stat(density)), fill="gray",bins=30) +
geom_vline(aes(xintercept=(`alpha[3, 1]`-`alpha[1, 1]`)), stat="mean_vline", linetype="dotted") +
geom_rug(stat="sample_mean", sides="b")
