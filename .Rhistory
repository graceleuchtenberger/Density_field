summary(model)
mean_sizes <- sizes %>%
group_by(bag_num) %>%
summarise(mean_length = mean(predicted, na.rm = TRUE),
std_error = sd(predicted, na.rm = TRUE)/sqrt(length(mean_length)),
.groups = 'drop')
mean_sizes <- sizes %>%
group_by(bag_num) %>%
summarise(mean_length = mean(length, na.rm = TRUE),
